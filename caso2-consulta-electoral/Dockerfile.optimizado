# Imagen ligera de Python
FROM python:3.11-alpine

LABEL maintainer="solanch.veliz@tecsup.edu.pe"
LABEL description="Registro electoral - imagen optimizada"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Copiar primero las dependencias mejora el uso de la caché
COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Copiar solamente los archivos necesarios
COPY app.py .
COPY templates ./templates

# Crear un usuario sin privilegios
RUN adduser -D appuser \
    && mkdir -p /app/datos \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')" || exit 1

CMD ["python", "app.py"]